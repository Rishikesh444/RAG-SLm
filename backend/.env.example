# LLM Provider Configuration
# Supported providers: "gemini" or "openai"
LLM_PROVIDER=gemini

# API Keys (Provide the one corresponding to your chosen provider)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Embedding Configuration
# We use a lightweight local model by default (no embedding API key needed)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Storage paths
CHROMA_DB_DIR=storage/chroma_db
UPLOAD_DIR=storage/uploads

# Text Chunking Settings
CHUNK_SIZE=500
CHUNK_OVERLAP=100
